# Copy this file to .env and adjust as needed.
# Never commit a real .env file with production credentials.

# --- Database ---
POSTGRES_USER=tradeblock
POSTGRES_PASSWORD=tradeblock
POSTGRES_DB=tradeblock
POSTGRES_PORT=5432

# Used by the backend service. When running via docker-compose, "db" is
# the service name and resolves on the compose network.
DATABASE_URL=postgresql+psycopg2://tradeblock:tradeblock@db:5432/tradeblock

# --- App ---
APP_ENV=development
DEMO_MODE=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
